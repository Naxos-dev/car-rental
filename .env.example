VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
VITE_CHECKOUT_FUNCTION_URL=/api/create-checkout-session

# Signing secret for the /api/stripe-webhook endpoint (Stripe Dashboard → Webhooks, or
# `stripe listen` output for local dev). Required for the reservation to be recorded after
# a successful payment.
STRIPE_WEBHOOK_SECRET=whsec_...

# Comma-separated production origins allowed as Stripe cancel_url / CORS origin, e.g.
# https://myapp.com,https://myapp.vercel.app
ALLOWED_ORIGINS=

# Firebase Admin service account JSON, base64-encoded. Used server-side to check vehicle
# availability (bypasses Firestore security rules for this trusted read).
FIREBASE_SERVICE_ACCOUNT_KEY=

# Resend (https://resend.com/api-keys) — sends the reservation confirmation email.
# RESEND_FROM_EMAIL must be an address on a domain verified in your Resend account.
# If either is unset, reservation creation still succeeds but no email is sent (logged as a warning).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=reservations@yourdomain.com

# Where operational incident alerts are sent (payment captured but reservation not recorded,
# confirmation email that failed to send, payment failures). Sent via the Resend account above,
# so it's unset by default rather than assumed equal to RESEND_FROM_EMAIL.
ADMIN_ALERT_EMAIL=admin@yourdomain.com
