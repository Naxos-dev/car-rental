rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Un utilisateur ne doit jamais pouvoir écrire son propre champ `role` :
    // isAdmin() lit users/{uid}.role, donc un create/update libre permettrait
    // à n'importe quel compte de s'auto-promouvoir admin.
    function roleUnchanged() {
      return (!("role" in request.resource.data) && !("role" in resource.data))
        || (("role" in request.resource.data) && ("role" in resource.data)
            && request.resource.data.role == resource.data.role);
    }

    // ── Users ───────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && !("role" in request.resource.data);
      allow update: if (isOwner(userId) && roleUnchanged()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Vehicles ────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── Locations (pickup points: nom + adresse) ─────────────
    match /locations/{locationId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ── Reservations ────────────────────────────────────────
    match /reservations/{reservationId} {
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Création réservée aux admins : le paiement client (Stripe) écrit la réservation via le
      // webhook (api/stripe-webhook.js), qui utilise l'Admin SDK et contourne ces règles — un
      // utilisateur n'a donc jamais besoin d'un droit de création direct. L'autoriser permettait
      // à n'importe quel compte de créer un faux document "confirmee" sans payer et de bloquer
      // des dates pour les autres clients (statut lu par api/_stripe-helpers.js, pas le paiement).
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Archived reservations ────────────────────────────────
    match /reservations_archived/{reservationId} {
      allow read:   if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write:  if isAdmin();
    }
  }
}
